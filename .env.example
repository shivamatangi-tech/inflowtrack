# Firebase Authentication Configuration (Public Web Config is in firebase-applet-config.json)
FIREBASE_PROJECT_ID=inflowtrack-06
FIREBASE_API_KEY=

# Session & Token Verification Secret (Server-side only)
SESSION_SECRET=

# Google Sheets Primary Finance Database Configuration (Server-side only - NEVER expose in VITE_ vars)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SPREADSHEET_NAME=inflowtrack

# Google Drive Private Backup & Receipt Storage Folder (https://drive.google.com/drive/folders/1vzWhp8o3I_3jbtGvS0NUS2Xo-VdOBYKb)
GOOGLE_DRIVE_FOLDER_NAME=inflowtrack
GOOGLE_DRIVE_FOLDER_ID=1vzWhp8o3I_3jbtGvS0NUS2Xo-VdOBYKb

# Option A: Google Service Account Credentials (Recommended - share private Sheet & Drive folder with this email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Option B: Server-side Google OAuth2 Refresh Token Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Option C: Private Google Apps Script Web App Bridge (Server-to-Server with shared secret)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
