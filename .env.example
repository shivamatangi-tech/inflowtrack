# =============================================================================
# inflotrack — Environment Configuration Example
# =============================================================================

# Server Port (dev server must run on 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Session secret for backend token signing (auto-generated if omitted)
SESSION_SECRET=

# Firebase Configuration (defaults loaded from firebase-applet-config.json)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Google Sheets & Drive Integration (Optional server-side credentials)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SPREADSHEET_NAME=inflowtrack
GOOGLE_DRIVE_FOLDER_ID=1WTHHDzwzO79ypcP06ZmDkBuDADosnH30
GOOGLE_DRIVE_FOLDER_NAME=inflowtrack

# Google Service Account (Option A)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google OAuth2 Refresh Token (Option B)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Apps Script Webhook (Option C)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
